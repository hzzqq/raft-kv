# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.txt

# Coverage/tool scratch dirs written by `go test -coverprofile` (covtest_xxx/)
covtest_*/
covtest_*/**

# Dependency directories
vendor/

# Go workspace file
go.work
go.work.sum

# Editor / OS
.idea/
.vscode/
.DS_Store

# Python cache (scripts/ 下免 Go 校验器的 __pycache__)
__pycache__/
*.pyc
*.pyo

# WorkBuddy agent internal state (not part of the project)
.workbuddy/

# Local debug / scratch artifacts (never commit)
tmp_*
tmp_*.log
tmp_*.txt
tmp_*.sh

# Build output (make build-binaries / start scripts)
bin/

# 启动脚本运行时产物（网关 PID 文件 / 日志）
raft-kv-gateway.pid
raft-kv-gateway.log
*.pid

# build_local.py 内存下载的本地 Go 工具链与构建缓存（体积大、机器相关，勿提交）
.go-sdk/
.gocache/
# 托管 Go 专用干净构建缓存（与本机坏安装 E:\e\go-sdk 隔离，防 GOCACHE 跨模块污染误报 not in std）。
# deploy_smoke 与 check_deploy_invariant 各用独立目录，避免 check_all 连跑时互相污染。
.gocache_smoke/
.gocache_invariant/
# deploy_smoke Witness 阶段专用干净构建缓存（与 .gocache_smoke 同性质，体积大、机器相关）。
.gocache_witness/
# 部署冒烟 / 门禁本地运行日志（调试产物，勿提交；真实结论进 check_all / CHANGELOG）。
*.smoke.log
witness_smoke*.log
inv.log
checkall.log
gencl.log
coverage_drift_debug.txt
.gopath/
.tcp_test_out.log
.smoke/
# 下载缓存（如原生 Prometheus/Grafana 二进制；本环境大文件下载被限速，按需本地缓存、勿提交）。
.cache/

# 实验运行时产物（go run -scenario 生成：控制台读取 + -assert 门禁复用）。
# 由 pre-commit 钩子（check_all → check_deploy_invariant）每次提交重跑重新生成，
# 属运行时产物，勿提交以免每次提交后工作树被钩子重写而永久 dirty。
experiments/results/client_view_*.json
experiments/results/generated_at.json
experiments/results/perf_shard_scaling.json
experiments/results/perf_shard_scaling.svg
experiments/results/scene_*.log

# 本地真实部署冒烟证据（deploy_smoke_local.py 生成，可审计/可展示产物，勿提交）。
deploy/smoke_report.json
deploy_reconfig*.log
deploy_*.log
smoke_report.json

# 单测/诊断临时日志（diag_e5*.log 等调试输出，勿提交）
diag_e5*.log
